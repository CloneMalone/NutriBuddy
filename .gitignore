# Ignore all node_modules recursively
node_modules/
**/node_modules/

# Ignore build output
dist/
build/

# Ignore TypeScript declaration maps
*.d.ts
*.d.ts.map

# Ignore TypeScript output
*.js
*.js.map

# Ignore log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE/editor folders
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore singular files
/repomix-output.xml
/education.md
/frontend-example.md
/instructions.md

# Ignore coverage reports
coverage/
.nyc_output/

# Optional: ignore temporary files
*.tmp
*.swp
